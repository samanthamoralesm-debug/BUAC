        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;%%{init: {\n  \&quot;theme\&quot;: \&quot;default\&quot;,\n  \&quot;themeVariables\&quot;: {\n    \&quot;darkMode\&quot;: false,\n    \&quot;background\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;lineColor\&quot;: \&quot;#0f172a\&quot;,\n    \&quot;arrowColor\&quot;: \&quot;#0f172a\&quot;,\n    \&quot;fontFamily\&quot;: \&quot;arial\&quot;\n  }\n}}%%\ngraph LR\n    %% Componentes externos independientes (sin recuadros)\n    Batt[\&quot;Batería Li-Po 1S 3.7 V &lt;br/&gt;+ TP4056 / DW01 (protección)\&quot;] --&gt; LDO[\&quot;LDO RT9080-33 (Iq 2 µA) &lt;br/&gt;Cin 1 µF / Cout 10 µF\&quot;]\n    Sensor[\&quot;Sensor Capacitivo TTP223 &lt;br/&gt;(modo rápido, LED del módulo retirado)\&quot;]\n    Batt --&gt; Div[\&quot;Divisor 2× 1 MΩ &lt;br/&gt;+ 100 nF (VBAT/2)\&quot;]\n    LDO --&gt;|3.3 V| Sensor\n    \n    Opto[\&quot;Optoacoplador PC817 &lt;br/&gt;(Aislamiento Galvánico ≥ 5 kV)\&quot;] --&gt;|C → BTN/RTE · E → GND/COM + TVS| Citofono[\&quot;Citófono Hikvision &lt;br/&gt;(Entrada RTE / Botón de salida)\&quot;]\n    LED[\&quot;LED Indicador rojo &lt;br/&gt;(Retroalimentación Visual)\&quot;]\n\n    %% Único contenedor con recuadro: El Microcontrolador ESP32-C3 y sus pines\n    subgraph MCU [\&quot;ESP32-C3-WROOM-02 (módulo) - Microcontrolador Central\&quot;]\n        direction TB\n        subgraph InPins [\&quot;Pines de Entrada / Alimentación\&quot;]\n            direction TB\n            P_VCC[\&quot;3V3 / GND &lt;br/&gt;(10 µF + 100 nF)\&quot;]\n            P_GPIO3[\&quot;GPIO 3 (ADC1_CH3) &lt;br/&gt;Telemetría Batería\&quot;]\n            P_GPIO0[\&quot;GPIO 0 (Deep-sleep GPIO Wake-up) &lt;br/&gt;Entrada Proximidad\&quot;]\n        end\n\n        subgraph OutPins [\&quot;Pines de Salida / Control\&quot;]\n            direction TB\n            P_GPIO1[\&quot;GPIO 1 &lt;br/&gt;(Control Opto / RTE) &lt;br/&gt;Pull-down 100 kΩ\&quot;]\n            P_GPIO2[\&quot;GPIO 4 &lt;br/&gt;(PWM LED Indicador)\&quot;]\n        end\n    end\n\n    %% Conexiones hacia/desde el Microcontrolador\n    LDO ==&gt;|3.3 V regulada| P_VCC\n    Div --&gt;|VBAT/2 ≤ 2.1 V| P_GPIO3\n    Sensor --&gt;|OUT activo alto &lt;br/&gt;Wake-up + validación 50 ms| P_GPIO0\n\n    P_GPIO1 --&gt;|220 Ω, IF ≈ 9.5 mA| Opto\n    P_GPIO2 --&gt;|330 Ω, ≈ 3.9 mA| LED\n\n    %% Estilos limpios y forzados para evitar fondos negros en draw.io\n    style MCU fill:#f8fafc,stroke:#2563eb,stroke-width:2.5px,color:#0f172a;\n    style InPins fill:#ffffff,stroke:#cbd5e1,stroke-width:1.5px,color:#0f172a;\n    style OutPins fill:#ffffff,stroke:#cbd5e1,stroke-width:1.5px,color:#0f172a;\n\n    classDef pinBox fill:#38bdf8,stroke:#0284c7,stroke-width:2px,color:#ffffff;\n    classDef power fill:#d97706,stroke:#b45309,stroke-width:2px,color:#ffffff;\n    classDef sensor fill:#0d9488,stroke:#0f766e,stroke-width:2px,color:#ffffff;\n    classDef opto fill:#7c3aed,stroke:#6d28d9,stroke-width:2px,color:#ffffff;\n    classDef ext fill:#e11d48,stroke:#be123c,stroke-width:2px,color:#ffffff;\n    classDef led fill:#ca8a04,stroke:#a16207,stroke-width:2px,color:#ffffff;\n    classDef passive fill:#475569,stroke:#334155,stroke-width:2px,color:#ffffff;\n\n    class P_VCC,P_GPIO3,P_GPIO0,P_GPIO1,P_GPIO2 pinBox;\n    class Batt,LDO power;\n    class Sensor sensor;\n    class Opto opto;\n    class Citofono ext;\n    class LED led;\n    class Div passive;&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="3--UwDYoeb955-La7nmg-143">
