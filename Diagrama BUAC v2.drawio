      <mxCell id="v2-ldo-ttp" value="3.3 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;startArrow=none;endArrow=block;endSize=8;strokeColor=light-dark(#0F172A,#1A1A1A);html=1;fontSize=14;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="3--UwDYoeb955-La7nmg-143" source="3--UwDYoeb955-La7nmg-153" target="3--UwDYoeb955-La7nmg-154"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v2-barrier" value="" style="html=1;shape=line;direction=south;dashed=1;dashPattern=4 3;strokeWidth=3;strokeColor=#DC2626;fillColor=none;" vertex="1" parent="3--UwDYoeb955-La7nmg-143"><mxGeometry x="1274" y="205" width="20" height="190" as="geometry" /></mxCell><mxCell id="v2-barrier-lbl" value="&lt;b&gt;Barrera de aislamiento&lt;/b&gt;&lt;br&gt;≥ 1500 VAC (NF-01)&lt;br&gt;creepage ≥ 6 mm · ranura bajo el PC817&lt;br&gt;sin GND común con el citófono" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#DC2626;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="3--UwDYoeb955-La7nmg-143"><mxGeometry x="1150" y="115" width="270" height="85" as="geometry" /></mxCell><mxCell id="v2-mcu-support" value="&lt;b&gt;Circuito de soporte ESP32-C3&lt;/b&gt;&lt;br&gt;EN: RC 10 kΩ + 1 µF · BOOT: GPIO9 (pulsador)&lt;br&gt;USB nativo: GPIO18/19 (programación)&lt;br&gt;Strapping: pull-up 10 kΩ en GPIO2, GPIO8 y GPIO9&lt;br&gt;Antena al borde de la PCB + keep-out sin cobre&lt;br&gt;Test points: 3V3, VBAT, GND, GPIO0, GPIO1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#EFF6FF,#CCE5FF);strokeColor=#2563EB;fontColor=light-dark(#0F172A,#1A1A1A);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="3--UwDYoeb955-La7nmg-143"><mxGeometry x="700" y="1080" width="299" height="150" as="geometry" /></mxCell><mxCell id="v2-fw-notes" value="&lt;b&gt;Notas de firmware&lt;/b&gt;&lt;br&gt;• gpio_hold_en(GPIO1) en nivel bajo antes de Deep Sleep&lt;br&gt;• Validar 50 ms contando desde el wake-up (no desde app_main)&lt;br&gt;• CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y&lt;br&gt;• Bloqueo de 3–5 s y esperar liberación antes de rearmar el wake-up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#F8FAFC,#E0E0E0);strokeColor=#94A3B8;dashed=1;fontColor=light-dark(#0F172A,#1A1A1A);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="3--UwDYoeb955-La7nmg-143"><mxGeometry x="1180" y="640" width="380" height="130" as="geometry" /></mxCell></root>
    </mxGraphModel>
